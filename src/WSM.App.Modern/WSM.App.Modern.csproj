<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WSM.App.Modern</RootNamespace>
    <AssemblyName>WSM</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\WSM.App.Shared\Assets\wsm-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WSM.App.Shared\WSM.App.Shared.csproj" />
    <ProjectReference Include="..\WSM.Infrastructure\WSM.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\winsw\WinSW-net461.exe" Link="winsw\WinSW-net461.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\assets\winsw\WinSW-net461.exe')" />
    <None Include="..\..\assets\winsw\WinSW-x64.exe" Link="winsw\WinSW-x64.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\assets\winsw\WinSW-x64.exe')" />
    <None Include="..\..\assets\winsw\WinSW-x86.exe" Link="winsw\WinSW-x86.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\assets\winsw\WinSW-x86.exe')" />
    <None Include="..\WSM.App.Shared\Assets\wsm-logo.ico" Link="Assets\wsm-logo.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\WSM.App.Shared\Assets\wsm-logo-64.png" Link="Assets\wsm-logo-64.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
