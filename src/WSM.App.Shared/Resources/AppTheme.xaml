<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:converters="clr-namespace:WSM.App.Shared.Converters"
  xmlns:models="clr-namespace:WSM.Core.Models;assembly=WSM.Core">

  <ResourceDictionary.MergedDictionaries>
    <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Teal" />
    <ResourceDictionary Source="pack://application:,,,/WSM.App.Shared;component/Resources/AppFontFamilies.xaml" />
    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DataGrid.xaml" />
    <ResourceDictionary Source="pack://application:,,,/WSM.App.Shared;component/Resources/AppTypography.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
  <converters:StepVisibilityConverter x:Key="StepVisibilityConverter" />
  <converters:StepIsLastVisibilityConverter x:Key="StepIsLastVisibilityConverter" />
  <converters:StepIsNotLastVisibilityConverter x:Key="StepIsNotLastVisibilityConverter" />
  <converters:StepCanGoBackConverter x:Key="StepCanGoBackConverter" />

  <SolidColorBrush x:Key="ServiceStatusRunningForeground" Color="#2E7D32" />
  <SolidColorBrush x:Key="ServiceStatusStoppedForeground" Color="#B71C1C" />
  <SolidColorBrush x:Key="ServiceStatusPendingForeground" Color="#EF6C00" />
  <SolidColorBrush x:Key="ServiceStatusNeutralForeground" Color="#616161" />
  <SolidColorBrush x:Key="ServiceActionDangerForeground" Color="#C62828" />
  <SolidColorBrush x:Key="ServiceActionSecondaryForeground" Color="#424242" />

  <Style x:Key="ServiceStatusIconStyle" TargetType="materialDesign:PackIcon">
    <Setter Property="Kind" Value="AlertCircleOutline" />
    <Setter Property="Foreground" Value="{DynamicResource ServiceStatusNeutralForeground}" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ServiceRuntimeStatus.Running}">
        <Setter Property="Kind" Value="PlayCircle" />
        <Setter Property="Foreground" Value="{DynamicResource ServiceStatusRunningForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ServiceRuntimeStatus.Stopped}">
        <Setter Property="Kind" Value="StopCircleOutline" />
        <Setter Property="Foreground" Value="{DynamicResource ServiceStatusStoppedForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ServiceRuntimeStatus.StartPending}">
        <Setter Property="Kind" Value="ProgressClock" />
        <Setter Property="Foreground" Value="{DynamicResource ServiceStatusPendingForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ServiceRuntimeStatus.StopPending}">
        <Setter Property="Kind" Value="ProgressClock" />
        <Setter Property="Foreground" Value="{DynamicResource ServiceStatusPendingForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ServiceRuntimeStatus.NotInstalled}">
        <Setter Property="Kind" Value="AlertCircleOutline" />
        <Setter Property="Foreground" Value="{DynamicResource ServiceStatusNeutralForeground}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ServiceStatusTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ServiceStatusNeutralForeground}" />
    <Setter Property="Margin" Value="0 1.2 0 0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ServiceRuntimeStatus.Running}">
        <Setter Property="Foreground" Value="{DynamicResource ServiceStatusRunningForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ServiceRuntimeStatus.Stopped}">
        <Setter Property="Foreground" Value="{DynamicResource ServiceStatusStoppedForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ServiceRuntimeStatus.StartPending}">
        <Setter Property="Foreground" Value="{DynamicResource ServiceStatusPendingForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ServiceRuntimeStatus.StopPending}">
        <Setter Property="Foreground" Value="{DynamicResource ServiceStatusPendingForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ServiceRuntimeStatus.NotInstalled}">
        <Setter Property="Foreground" Value="{DynamicResource ServiceStatusNeutralForeground}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
