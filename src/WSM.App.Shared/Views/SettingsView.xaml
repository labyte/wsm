<UserControl x:Class="WSM.App.Shared.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

  
   <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Style="{StaticResource MaterialDesignScrollViewer}">
      <ScrollViewer.Resources>
        <Style TargetType="ScrollBar">
          <Setter Property="Width" Value="5" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Opacity" Value="0.42" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=IsMouseOver}" Value="True">
              <Setter Property="Width" Value="12" />
              <Setter Property="Opacity" Value="1" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ScrollViewer.Resources>
   <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.15*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="0.15*" />
        </Grid.ColumnDefinitions>
   <StackPanel Grid.Column="1" HorizontalAlignment="Stretch">
    <TextBlock Text="应用设置"
               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
               Margin="0,0,0,16" />

    <materialDesign:Card Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="运行权限"
                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <materialDesign:PackIcon Kind="ShieldAccount"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
          <TextBlock Text="{Binding AdminStatusText}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Opacity="0.8" />
        </StackPanel>
        <Button Margin="0,12,0,0"
                Style="{StaticResource MaterialDesignFlatButton}"
                HorizontalAlignment="Left"
                Command="{Binding RestartAsAdministratorCommand}"
                Content="以管理员身份重启"
                Visibility="{Binding IsRunningAsAdministrator, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        <TextBlock Margin="0,8,0,0"
                   Opacity="0.8"
                   TextWrapping="Wrap"
                   Text="安装、卸载、启动 Windows 服务均需管理员权限。直接运行 WSM.exe 时会自动弹出 UAC 提权。" />
      </StackPanel>
    </materialDesign:Card>

    <materialDesign:Card Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="窗口行为"
                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
        <TextBlock Margin="0,8,0,0"
                   Opacity="0.9"
                   Text="关闭主窗口时" />
        <StackPanel Margin="0,6,0,0">
          <RadioButton GroupName="CloseWindowBehavior"
                       Content="最小化到系统托盘"
                       IsChecked="{Binding MinimizeOnClose, Mode=TwoWay}" />
          <RadioButton GroupName="CloseWindowBehavior"
                       Margin="0,6,0,0"
                       Content="退出程序"
                       IsChecked="{Binding ExitOnClose, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock Margin="0,10,0,0"
                   Opacity="0.8"
                   TextWrapping="Wrap"
                   Text="选择「退出程序」后，点击窗口关闭按钮将直接结束 WSM；最小化窗口仍会进入托盘。" />
      </StackPanel>
    </materialDesign:Card>

    <materialDesign:Card Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="数据目录" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
        <TextBox Margin="0,8,0,0"
                 Text="{Binding DataRootPath, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="WSM 数据目录" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Style="{StaticResource MaterialDesignFlatButton}"
                  Command="{Binding BrowseDataRootCommand}"
                  Content="浏览..." />
          <Button Margin="8,0,0,0"
                  Style="{StaticResource MaterialDesignFlatButton}"
                  Command="{Binding ApplyDataRootCommand}"
                  Content="应用目录" />
        </StackPanel>
        <TextBlock Margin="0,10,0,0"
                   Opacity="0.8"
                   TextWrapping="Wrap"
                   Text="应用新目录前会先停止全部托管服务。建议应用后重启 WSM。" />
      </StackPanel>
    </materialDesign:Card>

    <materialDesign:Card Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="添加服务默认命名规则" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />

        <TextBlock Margin="0,8,0,0"
                   Opacity="0.9"
                   Text="服务 ID 规则" />
        <ComboBox Margin="0,6,0,0"
                  DisplayMemberPath="Display"
                  SelectedValuePath="Value"
                  ItemsSource="{Binding DefaultRuleOptions}"
                  SelectedValue="{Binding ServiceIdRuleMode, Mode=TwoWay}" />
        <TextBox Margin="0,6,0,0"
                 Visibility="{Binding IsServiceIdPrefixVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                 Text="{Binding ServiceIdRulePrefix, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="服务 ID 前缀（仅“前缀 + 程序名称”生效）" />

        <TextBlock Margin="0,10,0,0"
                   Opacity="0.9"
                   Text="服务名称规则" />
        <ComboBox Margin="0,6,0,0"
                  DisplayMemberPath="Display"
                  SelectedValuePath="Value"
                  ItemsSource="{Binding DefaultRuleOptions}"
                  SelectedValue="{Binding ServiceNameRuleMode, Mode=TwoWay}" />
        <TextBox Margin="0,6,0,0"
                 Visibility="{Binding IsServiceNamePrefixVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                 Text="{Binding ServiceNameRulePrefix, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="服务名称前缀（仅“前缀 + 程序名称”生效）" />

        <TextBlock Margin="0,10,0,0"
                   Opacity="0.9"
                   Text="描述规则" />
        <ComboBox Margin="0,6,0,0"
                  DisplayMemberPath="Display"
                  SelectedValuePath="Value"
                  ItemsSource="{Binding DefaultRuleOptions}"
                  SelectedValue="{Binding ServiceDescriptionRuleMode, Mode=TwoWay}" />
        <TextBox Margin="0,6,0,0"
                 Visibility="{Binding IsServiceDescriptionPrefixVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                 Text="{Binding ServiceDescriptionRulePrefix, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="描述前缀（仅“前缀 + 程序名称”生效）" />

        <Button Margin="0,12,0,0"
                Style="{StaticResource MaterialDesignFlatButton}"
                HorizontalAlignment="Left"
                Command="{Binding ApplyServiceNamingRulesCommand}"
                Content="应用默认命名规则" />
      </StackPanel>
    </materialDesign:Card>

    <materialDesign:Card Padding="16">
      <StackPanel>
        <TextBlock Text="关于 WSM"
                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
        <TextBlock Margin="0,10,0,0"
                   Opacity="0.9"
                   Text="{Binding AppVersion, StringFormat=版本：{0}}" />
        <TextBlock Margin="0,6,0,0"
                   Opacity="0.9"
                   Text="{Binding AppBuildDate, StringFormat=构建日期：{0}}" />
        <TextBlock Margin="0,6,0,0"
                   Opacity="0.9"
                   FontFamily="{StaticResource AppLogFontFamily}"
                   FontSize="12"
                   Text="{Binding AppFingerprint, StringFormat=指纹：{0}}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,12,0,0"
                   Opacity="0.9"
                   Text="{Binding CopyrightText}" />
      </StackPanel>
    </materialDesign:Card>
  </StackPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
