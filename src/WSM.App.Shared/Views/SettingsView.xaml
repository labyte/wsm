<UserControl x:Class="WSM.App.Shared.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

  
   <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Style="{StaticResource MaterialDesignScrollViewer}">
      <ScrollViewer.Resources>
        <Style TargetType="ScrollBar">
          <Setter Property="Width" Value="5" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Opacity" Value="0.42" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=IsMouseOver}" Value="True">
              <Setter Property="Width" Value="12" />
              <Setter Property="Opacity" Value="1" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ScrollViewer.Resources>
   <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.15*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="0.15*" />
        </Grid.ColumnDefinitions>
   <StackPanel Grid.Column="1" HorizontalAlignment="Stretch">
    <TextBlock Text="应用设置"
               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
               Margin="0,0,0,16" />

    <materialDesign:Card Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="运行权限"
                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <materialDesign:PackIcon Kind="ShieldAccount"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
          <TextBlock Text="{Binding AdminStatusText}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Opacity="0.85" />
        </StackPanel>
        <Button Margin="0,12,0,0"
                Style="{StaticResource MaterialDesignFlatButton}"
                HorizontalAlignment="Left"
                Command="{Binding RestartAsAdministratorCommand}"
                Content="以管理员身份重启"
                Visibility="{Binding IsRunningAsAdministrator, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        <TextBlock Margin="0,8,0,0"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   Text="安装、卸载、启动 Windows 服务均需管理员权限。直接运行 WSM.exe 时会自动弹出 UAC 提权。" />
      </StackPanel>
    </materialDesign:Card>

    <materialDesign:Card Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="数据目录" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
        <TextBox Margin="0,8,0,0"
                 Text="{Binding DataRootPath, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="WSM 数据目录" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Style="{StaticResource MaterialDesignFlatButton}"
                  Command="{Binding BrowseDataRootCommand}"
                  Content="浏览..." />
          <Button Margin="8,0,0,0"
                  Style="{StaticResource MaterialDesignFlatButton}"
                  Command="{Binding ApplyDataRootCommand}"
                  Content="应用目录" />
        </StackPanel>
        <TextBlock Margin="0,10,0,0"
                   Opacity="0.65"
                   TextWrapping="Wrap"
                   Text="应用新目录前会先停止全部托管服务。建议应用后重启 WSM。" />
      </StackPanel>
    </materialDesign:Card>

    <materialDesign:Card Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="WinSW 执行配置" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
        <ComboBox Margin="0,8,0,0"
                  DisplayMemberPath="Display"
                  SelectedValuePath="Value"
                  ItemsSource="{Binding WinSwToolModeOptions}"
                  SelectedValue="{Binding WinSwToolMode, Mode=TwoWay}" />
        <TextBox Margin="0,8,0,0"
                 IsEnabled="{Binding IsCustomWinSwPathEnabled}"
                 Text="{Binding CustomWinSwPath, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="自定义 WinSW.exe 路径（仅自定义模式）" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Style="{StaticResource MaterialDesignFlatButton}"
                  Command="{Binding BrowseWinSwPathCommand}"
                  IsEnabled="{Binding IsCustomWinSwPathEnabled}"
                  Content="浏览 WinSW..." />
          <Button Margin="8,0,0,0"
                  Style="{StaticResource MaterialDesignFlatButton}"
                  Command="{Binding ApplyWinSwToolCommand}"
                  Content="应用 WinSW 配置" />
        </StackPanel>
        <TextBlock Margin="0,10,0,0"
                   Opacity="0.65"
                   TextWrapping="Wrap"
                   Text="{Binding EffectiveWinSwPath, StringFormat=当前生效执行路径：{0}}" />
      </StackPanel>
    </materialDesign:Card>

    <materialDesign:Card Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="操作日志文件" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
        <TextBox Margin="0,8,0,0"
                 Text="{Binding OperationLogPath, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="NLog 操作日志文件路径（留空恢复默认）" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Style="{StaticResource MaterialDesignFlatButton}"
                  Command="{Binding BrowseOperationLogPathCommand}"
                  Content="浏览日志文件..." />
          <Button Margin="8,0,0,0"
                  Style="{StaticResource MaterialDesignFlatButton}"
                  Command="{Binding ApplyOperationLogPathCommand}"
                  Content="应用日志路径" />
        </StackPanel>
        <TextBlock Margin="0,10,0,0"
                   Opacity="0.65"
                   TextWrapping="Wrap"
                   Text="该文件用于记录安装、卸载、启动、停止、刷新等软件操作。留空后将恢复为默认路径（数据目录\\logs\\operations.log）。" />
      </StackPanel>
    </materialDesign:Card>

    <materialDesign:Card Padding="16">
      <StackPanel>
        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Opacity="0.85" />
        <TextBlock Margin="0,12,0,0"
                   Opacity="0.6"
                   Text="{Binding AppVersion, StringFormat=版本 {0}}" />
      </StackPanel>
    </materialDesign:Card>
  </StackPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
