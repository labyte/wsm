<UserControl x:Class="WSM.App.Shared.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

  <StackPanel MaxWidth="640">
    <TextBlock Text="应用设置"
               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
               Margin="0,0,0,16" />

    <materialDesign:Card Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="运行权限"
                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <materialDesign:PackIcon Kind="ShieldAccount"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
          <TextBlock Text="{Binding AdminStatusText}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Opacity="0.85" />
        </StackPanel>
        <Button Margin="0,12,0,0"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                HorizontalAlignment="Left"
                Command="{Binding RestartAsAdministratorCommand}"
                Content="以管理员身份重启"
                Visibility="{Binding IsRunningAsAdministrator, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        <TextBlock Margin="0,8,0,0"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   Text="安装、卸载、启动 Windows 服务均需管理员权限。直接运行 WSM.exe 时会自动弹出 UAC 提权。" />
      </StackPanel>
    </materialDesign:Card>

    <materialDesign:Card Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="数据目录" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
        <TextBox Margin="0,8,0,0"
                 Text="{Binding DataRootPath, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="WSM 数据目录" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                  Command="{Binding BrowseDataRootCommand}"
                  Content="浏览..." />
          <Button Margin="8,0,0,0"
                  Style="{StaticResource MaterialDesignRaisedButton}"
                  Command="{Binding ApplyDataRootCommand}"
                  Content="应用目录" />
        </StackPanel>
        <TextBlock Margin="0,10,0,0"
                   Opacity="0.65"
                   TextWrapping="Wrap"
                   Text="应用新目录前会先停止全部托管服务。建议应用后重启 WSM。" />
      </StackPanel>
    </materialDesign:Card>

    <materialDesign:Card Padding="16">
      <StackPanel>
        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Opacity="0.85" />
        <TextBlock Margin="0,12,0,0"
                   Opacity="0.6"
                   Text="{Binding AppVersion, StringFormat=版本 {0}}" />
      </StackPanel>
    </materialDesign:Card>
  </StackPanel>
</UserControl>
