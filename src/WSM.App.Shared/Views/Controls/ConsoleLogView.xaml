<UserControl x:Class="WSM.App.Shared.Views.Controls.ConsoleLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="800">

  <UserControl.Resources>
    <Style x:Key="ConsoleVerticalScrollBarStyle"
           TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="6" />
      <Setter Property="Background" Value="#2B2B2B" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track"
                     IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Background="#A0A0A0"
                         BorderBrush="#A0A0A0"
                         BorderThickness="0"
                         Margin="0,2,0,2" />
                </Track.Thumb>
              </Track>

              <RepeatButton x:Name="LineUpButton"
                            Command="ScrollBar.LineUpCommand"
                            VerticalAlignment="Top"
                            Height="12"
                            Visibility="Collapsed" />
              <RepeatButton x:Name="LineDownButton"
                            Command="ScrollBar.LineDownCommand"
                            VerticalAlignment="Bottom"
                            Height="12"
                            Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Width" Value="12" />
                <Setter TargetName="LineUpButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="LineDownButton" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="#1E1E1E"
          CornerRadius="4"
          Padding="12">
    <TextBox x:Name="LogTextBox"
             Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
             TextChanged="OnLogTextChanged"
             IsReadOnly="True"
             AcceptsReturn="True"
             AcceptsTab="True"
             BorderThickness="0"
             Background="Transparent"
             Foreground="#D4D4D4"
             CaretBrush="#D4D4D4"
             FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
             FontSize="13"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Disabled">
      <TextBox.Resources>
        <Style TargetType="{x:Type ScrollBar}"
               BasedOn="{StaticResource ConsoleVerticalScrollBarStyle}" />
      </TextBox.Resources>
      <TextBox.Style>
        <Style TargetType="{x:Type TextBox}">
          <Setter Property="TextWrapping" Value="NoWrap" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding WrapLines, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Value="True">
              <Setter Property="TextWrapping" Value="Wrap" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBox.Style>
    </TextBox>
  </Border>
</UserControl>
