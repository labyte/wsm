<UserControl x:Class="WSM.App.Shared.Views.ServiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="480"
             d:DesignWidth="900">
  <UserControl.Resources>
    <Style x:Key="ServiceSelectionCheckBoxStyle" TargetType="CheckBox">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ServiceActionIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="MoreMenuIconStyle" TargetType="materialDesign:PackIcon">
      <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right"
              Style="{StaticResource MaterialDesignFlatButton}"
              Command="{Binding RefreshCommand}"
              Content="刷新" />
      <TextBlock Text="已注册的 Windows 服务"
                 VerticalAlignment="Center"
                 Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
    </DockPanel>

    <Grid Grid.Row="1">
      <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                   Value="0"
                   IsIndeterminate="True"
                   Width="40"
                   Height="40"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <TextBlock Text="暂无托管服务，请点击左下角「添加服务」注册。"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Style="{StaticResource AppTextSecondaryStyle}"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <DataGrid x:Name="ServicesDataGrid"
                ItemsSource="{Binding Services}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeRows="False"
                IsReadOnly="False"
                SelectionMode="Single"
                SelectionUnit="Cell"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                Style="{StaticResource MaterialDesignDataGrid}"
          
                >
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader"
                 BasedOn="{StaticResource AppDataGridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
          </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.Resources>
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
          <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1F1F1F" />
          <Style x:Key="CenteredHeaderStyle"
                 TargetType="DataGridColumnHeader"
                 BasedOn="{StaticResource AppDataGridColumnHeaderStyle}">
            <Setter Property="Padding" Value="12,8,28,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
          </Style>
        </DataGrid.Resources>
        <DataGrid.CellStyle>
          <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="12 0 0 0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.CellStyle>
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="52"
                                  IsReadOnly="False" >
            <DataGridTemplateColumn.HeaderTemplate>
              <DataTemplate>
                <Grid HorizontalAlignment="Left"  VerticalAlignment="Center">
                  <CheckBox Style="{StaticResource ServiceSelectionCheckBoxStyle}" 
                            IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.HeaderTemplate>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                  <CheckBox Style="{StaticResource ServiceSelectionCheckBoxStyle}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="服务名称"
                              Binding="{Binding DisplayName}"
                              IsReadOnly="True"
                              Width="0.5*" MinWidth="160">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="状态" Width="0.5*" MinWidth="140">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch"  Margin="0">
                  <materialDesign:PackIcon
                                           Style="{StaticResource ServiceStatusIconStyle}"
                                           Margin="-2,0,4,0"
                                           VerticalAlignment="Center"  />
                  <TextBlock
                             Style="{StaticResource ServiceStatusTextStyle}"
                             Text="{Binding StatusText}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="开始时间"
                              Binding="{Binding StartedAtText}"
                              IsReadOnly="True"
                              MinWidth="150" Width="0.5*">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="程序目录" Width="*" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock VerticalAlignment="Center" Padding="0"
                           ToolTip="{Binding ProgramDirectory}"
                           TextTrimming="CharacterEllipsis">
                  <Hyperlink Command="{Binding DataContext.OpenProgramDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             CommandParameter="{Binding}"
                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}">
                    <Run Text="{Binding ProgramDirectory, Mode=OneWay}" />
                  </Hyperlink>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="操作" Width="auto" IsReadOnly="True" >
            <DataGridTemplateColumn.HeaderTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <Button Style="{StaticResource ServiceActionIconButtonStyle}"
                          ToolTip="一键启动所选服务"
                          Command="{Binding DataContext.StartSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <materialDesign:PackIcon Kind="Play" Foreground="#2E7D32" Width="22" Height="22" />
                  </Button>
                  <Button Style="{StaticResource ServiceActionIconButtonStyle}"
                          Margin="8,0,0,0"
                          ToolTip="一键停止所选服务"
                          Command="{Binding DataContext.StopSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <materialDesign:PackIcon Kind="Stop" Foreground="#B71C1C" Width="22" Height="22" />
                  </Button>
                  <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                           StaysOpen="False"
                                           IsPopupOpen="{Binding DataContext.IsConfirmingBatchUninstall, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}">
                    <materialDesign:PopupBox.ToggleContent>
                      <Button Style="{StaticResource ServiceActionIconButtonStyle}"
                              Margin="8,0,0,0"
                              ToolTip="一键卸载所选服务"
                              Command="{Binding DataContext.OpenBatchUninstallConfirmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="TrashCanOutline"
                                                 Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                                                 Width="22"
                                                 Height="22" />
                      </Button>
                    </materialDesign:PopupBox.ToggleContent>
                    <Border Width="260"
                            Padding="12"
                            CornerRadius="6"
                            Background="{DynamicResource MaterialDesignPaper}">
                      <StackPanel>
                        <TextBlock Text="确认一键卸载已选服务？"
                                   FontFamily="{StaticResource AppFontMedium}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource AppTextSecondaryStyle}"
                                   Text="{Binding DataContext.SelectedServices.Count, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=当前已选 {0} 个服务，卸载后将移除部署内容。}" />
                        <StackPanel Margin="0,10,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                          <Button Style="{StaticResource MaterialDesignFlatButton}"
                                  Command="{Binding DataContext.CancelBatchUninstallConfirmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Content="取消" />
                          <Button Margin="8,0,0,0"
                                  Style="{StaticResource MaterialDesignFlatButton}"
                                  Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                                  Command="{Binding DataContext.UninstallSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Content="确认卸载" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </materialDesign:PopupBox>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.HeaderTemplate>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="2 0 0 0">
                  <Button Style="{StaticResource ServiceActionIconButtonStyle}"
                          Margin="0,0,8,0"
                          ToolTip="启动"
                          Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="PlayCircleOutline"
                                             Foreground="#2E7D32"
                                             Width="22"
                                             Height="22" />
                  </Button>
                  <Button Style="{StaticResource ServiceActionIconButtonStyle}"
                          Margin="0,0,8,0"
                          ToolTip="停止"
                          Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="StopCircleOutline"
                                             Foreground="#B71C1C"
                                             Width="22"
                                             Height="22" />
                  </Button>
                  <Button Style="{StaticResource ServiceActionIconButtonStyle}"
                          Margin="0,0,8,0"
                          ToolTip="重启"
                          Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                    <materialDesign:PackIcon Kind="Restart"
                                             Foreground="{DynamicResource MaterialDesignBody}"
                                             Width="22"
                                             Height="22" />
                  </Button>
                  <materialDesign:PopupBox PlacementMode="BottomAndAlignLeftEdges"
                                           HorizontalAlignment="Center" Width="30" 
                                           StaysOpen="False">
                    <materialDesign:PopupBox.ToggleContent>
                      <materialDesign:PackIcon Kind="DotsHorizontal"
                                               Width="20"
                                               Height="20"
                                               Margin="4,0,4,0"
                                               Cursor="Hand"
                                               ToolTip="更多操作"
                                               Style="{StaticResource MoreMenuIconStyle}" />
                    </materialDesign:PopupBox.ToggleContent>
                    <StackPanel MinWidth="160">
                      <Button Style="{StaticResource MaterialDesignFlatButton}"
                              HorizontalContentAlignment="Left"
                              Foreground="#2E7D32"
                              Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                          <materialDesign:PackIcon Kind="PlayCircleOutline"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,0,8,0"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                          <TextBlock Text="启动" FontFamily="{StaticResource AppFontFamily}"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource MaterialDesignFlatButton}"
                              HorizontalContentAlignment="Left"
                              Foreground="#B71C1C"
                              Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                          <materialDesign:PackIcon Kind="StopCircleOutline"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,0,8,0"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                          <TextBlock Text="停止" FontFamily="{StaticResource AppFontFamily}"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource MaterialDesignFlatButton}"
                              HorizontalContentAlignment="Left"
                              Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                          <materialDesign:PackIcon Kind="Restart"
                                                   Foreground="{DynamicResource MaterialDesignBody}"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,0,8,0" />
                          <TextBlock Text="重启" FontFamily="{StaticResource AppFontFamily}"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource MaterialDesignFlatButton}"
                              HorizontalContentAlignment="Left"
                              Command="{Binding DataContext.OpenConsoleLogsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                          <materialDesign:PackIcon Kind="ConsoleLine"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,0,8,0" />
                          <TextBlock Text="控制台" FontFamily="{StaticResource AppFontFamily}"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>

                      <Button Style="{StaticResource MaterialDesignFlatButton}"
                      HorizontalContentAlignment="Left"
                      Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                      Command="{Binding DataContext.OpenUninstallConfirmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                          <materialDesign:PackIcon Kind="TrashCanOutline"
                               Width="18"
                               Height="18"
                               Margin="0,0,8,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                          <TextBlock Text="卸载" FontFamily="{StaticResource AppFontFamily}"
                            VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Separator Margin="0,4" />
                      <Button Style="{StaticResource MaterialDesignFlatButton}"
                              HorizontalContentAlignment="Left"
                              Command="{Binding DataContext.OpenConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                          <materialDesign:PackIcon Kind="TextBoxEditOutline"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,0,8,0" />
                          <TextBlock Text="配置" FontFamily="{StaticResource AppFontFamily}"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Style="{StaticResource MaterialDesignFlatButton}"
                              HorizontalContentAlignment="Left"
                              Command="{Binding DataContext.OpenProgramDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                          <materialDesign:PackIcon Kind="FolderOutline"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,0,8,0" />
                          <TextBlock Text="目录" FontFamily="{StaticResource AppFontFamily}"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </materialDesign:PopupBox>
                  <materialDesign:PopupBox PlacementMode="LeftAndAlignBottomEdges"
                                           PopupHorizontalOffset="-20" PopupVerticalOffset="-10"
                                           HorizontalAlignment="Right"
                                           IsPopupOpen="{Binding IsConfirmingUninstall }"
                                           StaysOpen="True">
                    <materialDesign:PopupBox.ToggleContent>
                      <Grid/>
                    </materialDesign:PopupBox.ToggleContent>
                    <Border Width="240" Padding="12" CornerRadius="6">
                      <StackPanel >
                        <TextBlock Text="确认卸载该服务？"
                           FontFamily="{StaticResource AppFontMedium}"
                           TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource AppTextSecondaryStyle}"
                           Text="此操作会移除该服务及其相关部署内容。" />
                        <StackPanel Margin="0,10,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                          <Button Style="{StaticResource MaterialDesignFlatButton}"
                          Command="{Binding DataContext.CancelUninstallConfirmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          Content="取消" />
                          <Button Margin="8,0,0,0"
                          Style="{StaticResource MaterialDesignFlatButton}"
                          Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                          Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          Content="确认卸载" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                  </materialDesign:PopupBox>

                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
   
  </Grid>
</UserControl>
