<UserControl x:Class="WSM.App.Shared.Views.ServiceInstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="800">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="{Binding CurrentStepTitle}"
               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
               Margin="0,0,0,16" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- 步骤 1：选择程序 -->
        <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=0}">
          <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                  HorizontalAlignment="Left"
                  Command="{Binding BrowseExecutableCommand}"
                  Content="浏览可执行文件..." />
          <TextBox Margin="0,12,0,0"
                   materialDesign:HintAssist.Hint="可执行文件路径"
                   Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox Margin="0,12,0,0"
                   materialDesign:HintAssist.Hint="工作目录"
                   Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox Margin="0,12,0,0"
                   materialDesign:HintAssist.Hint="启动参数"
                   Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- 步骤 2：基本信息 -->
        <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">
          <TextBox materialDesign:HintAssist.Hint="服务 ID（小写、数字、连字符）"
                   Text="{Binding ServiceId, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox Margin="0,12,0,0"
                   materialDesign:HintAssist.Hint="显示名称"
                   Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox Margin="0,12,0,0"
                   materialDesign:HintAssist.Hint="描述"
                   Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   MinHeight="72"
                   TextWrapping="Wrap" />
        </StackPanel>

        <!-- 步骤 3：运行与启动 -->
        <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">
          <ComboBox materialDesign:HintAssist.Hint="启动类型"
                    ItemsSource="{Binding StartModeOptions}"
                    SelectedItem="{Binding StartMode}" />
          <CheckBox Margin="0,12,0,0"
                    Content="延迟自动启动"
                    IsChecked="{Binding DelayedAutoStart}" />
          <TextBox Margin="0,12,0,0"
                   materialDesign:HintAssist.Hint="停止超时（秒）"
                   Text="{Binding StopTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
          <CheckBox Margin="0,12,0,0"
                    Content="安装后立即启动"
                    IsChecked="{Binding StartAfterInstall}" />
        </StackPanel>

        <!-- 步骤 4：守护与日志 -->
        <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=3}">
          <ComboBox materialDesign:HintAssist.Hint="失败重启策略模板"
                    ItemsSource="{Binding FailurePolicyTemplates}"
                    SelectedItem="{Binding FailurePolicyTemplate}" />
          <TextBlock Margin="0,16,0,0"
                     Opacity="0.7"
                     TextWrapping="Wrap"
                     Text="标准守护：2 次重启后停止；积极守护：3 次短延迟重启；仅监控：不自动重启。" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <Button DockPanel.Dock="Right"
              Style="{StaticResource MaterialDesignRaisedButton}"
              Command="{Binding InstallCommand}"
              Content="安装服务"
              Visibility="{Binding CurrentStep, Converter={StaticResource StepIsLastVisibilityConverter}}" />
      <Button DockPanel.Dock="Right"
              Margin="0,0,8,0"
              Style="{StaticResource MaterialDesignOutlinedButton}"
              Command="{Binding NextStepCommand}"
              Content="下一步"
              Visibility="{Binding CurrentStep, Converter={StaticResource StepIsNotLastVisibilityConverter}}" />
      <Button Style="{StaticResource MaterialDesignOutlinedButton}"
              Command="{Binding PreviousStepCommand}"
              Content="上一步"
              IsEnabled="{Binding CurrentStep, Converter={StaticResource StepCanGoBackConverter}}" />
    </DockPanel>
  </Grid>
</UserControl>
