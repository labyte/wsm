<UserControl x:Class="WSM.App.Shared.Views.ServiceInstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="800">

  <UserControl.Resources>
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.78" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Style="{StaticResource MaterialDesignScrollViewer}">
      <ScrollViewer.Resources>
        <Style TargetType="ScrollBar">
          <Setter Property="Width" Value="5" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Opacity" Value="0.42" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=IsMouseOver}" Value="True">
              <Setter Property="Width" Value="12" />
              <Setter Property="Opacity" Value="1" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ScrollViewer.Resources>
      <Grid HorizontalAlignment="Stretch"> 
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.15*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="0.15*" />
        </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" 
                  HorizontalAlignment="Stretch" >
        <materialDesign:Card Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="程序与基本信息"
                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="服务程序 *" Style="{StaticResource FieldLabelStyle}" />
              <Button Grid.Column="1"
                      Style="{StaticResource MaterialDesignFlatButton}"
                      HorizontalAlignment="Left"
                      Command="{Binding BrowseExecutableCommand}"
                      Content="选择服务程序..." />
            </Grid>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="可执行路径 *" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Grid.Column="1" Text="{Binding Draft.ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <TextBlock Margin="140,4,0,0"
                       Text="{Binding ExecutablePathError}"
                       Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                       FontSize="12" />

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="工作目录" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Grid.Column="1" Text="{Binding Draft.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="启动参数" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Grid.Column="1" Text="{Binding Draft.Arguments, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="服务 ID *" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Grid.Column="1" Text="{Binding Draft.Id, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <TextBlock Margin="140,4,0,0"
                       Text="{Binding ServiceIdError}"
                       Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                       FontSize="12" />

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="显示名称 *" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Grid.Column="1" Text="{Binding Draft.DisplayName, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <TextBlock Margin="140,4,0,0"
                       Text="{Binding DisplayNameError}"
                       Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                       FontSize="12" />

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="描述" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Grid.Column="1"
                       Text="{Binding Draft.Description, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True"
                       MinHeight="72"
                       TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="运行与启动"
                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="启动类型" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding StartModeOptions}"
                        SelectedItem="{Binding Draft.StartMode}" />
            </Grid>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="延迟启动" Style="{StaticResource FieldLabelStyle}" />
              <CheckBox Grid.Column="1"
                        Content="启用延迟自动启动"
                        IsChecked="{Binding Draft.DelayedAutoStart}" />
            </Grid>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="停止超时 *" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Grid.Column="1" Text="{Binding Draft.StopTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <TextBlock Margin="140,4,0,0"
                       Text="{Binding StopTimeoutError}"
                       Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                       FontSize="12" />

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="安装后启动" Style="{StaticResource FieldLabelStyle}" />
              <CheckBox Grid.Column="1"
                        Content="安装后立即启动服务"
                        IsChecked="{Binding Draft.StartAfterInstall}" />
            </Grid>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="自动刷新" Style="{StaticResource FieldLabelStyle}" />
              <CheckBox Grid.Column="1"
                        Content="启用自动刷新配置（autoRefresh）"
                        IsChecked="{Binding Draft.AutoRefresh}" />
            </Grid>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="隐藏窗口" Style="{StaticResource FieldLabelStyle}" />
              <CheckBox Grid.Column="1"
                        Content="隐藏程序窗口（hidewindow）"
                        IsChecked="{Binding Draft.HideWindow}" />
            </Grid>
          </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="自动恢复设置"
                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="崩溃恢复" Style="{StaticResource FieldLabelStyle}" />
              <CheckBox Grid.Column="1"
                        Content="启用崩溃自动恢复（进程退出自动重启）"
                        IsChecked="{Binding Draft.EnableCrashRecovery}" />
            </Grid>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="崩溃参数" Style="{StaticResource FieldLabelStyle}" />
              <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         materialDesign:HintAssist.Hint="重启延迟（秒）"
                         Text="{Binding Draft.CrashRestartDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="2"
                         materialDesign:HintAssist.Hint="最大重启次数"
                         Text="{Binding Draft.CrashMaxRestartCount, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </Grid>
          </StackPanel>
        </materialDesign:Card>
      </StackPanel>
      </Grid>
    </ScrollViewer>

    <Grid HorizontalAlignment="Stretch" Grid.Row="1"  Margin="0 20 20 0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.2*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="0.2*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="1"
                  HorizontalAlignment="Center">
        <Button 
                Style="{StaticResource MaterialDesignFlatButton}"
                Command="{Binding InstallCommand}"
                IsEnabled="{Binding CanInstallService}"
                ToolTip="{Binding InstallServiceToolTip}"
                ToolTipService.ShowOnDisabled="True"
                Content="安装服务" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                   FontSize="12"
                   Text="{Binding InstallPermissionHintText}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShowInstallPermissionHint}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
        </Grid>  
  </Grid>
</UserControl>
