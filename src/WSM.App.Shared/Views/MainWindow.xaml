<Window x:Class="WSM.App.Shared.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:WSM.App.Shared.Models"
        xmlns:vm="clr-namespace:WSM.App.Shared.ViewModels"
        xmlns:views="clr-namespace:WSM.App.Shared.Views"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="720"
        Width="1200"
        MinHeight="560"
        MinWidth="960"
        Loaded="Window_OnLoaded"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesignPaper}"
        Icon="/WSM.App.Shared;component/Assets/wsm-logo.ico">

  <Window.Resources>
    <Style x:Key="SidebarRailNavigationListBoxStyle" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesign3.NavigationRailPrimaryListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="materialDesign:NavigationRailAssist.IsTextVisible" Value="True" />
            <Setter Property="materialDesign:NavigationRailAssist.SelectedIcon" Value="{Binding IconKind}" />
            <Setter Property="materialDesign:NavigationRailAssist.UnselectedIcon" Value="{Binding IconKind}" />
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SidebarNavigationListBoxStyle" TargetType="ListBox">
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesign3.NavigationDrawerPrimaryListBoxItem}">
            <Setter Property="materialDesign:NavigationDrawerAssist.SelectedIcon" Value="{Binding IconKind}" />
            <Setter Property="materialDesign:NavigationDrawerAssist.UnselectedIcon" Value="{Binding IconKind}" />
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate DataType="{x:Type vm:ServiceListViewModel}">
      <views:ServiceListView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ServiceInstallViewModel}">
      <views:ServiceInstallView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ServiceConsoleViewModel}">
      <views:ServiceConsoleView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LogViewerViewModel}">
      <views:LogViewerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>

  <materialDesign:DialogHost Identifier="RootDialogHost">
    <materialDesign:DrawerHost x:Name="NavDrawer"
                               IsLeftDrawerOpen="{Binding ElementName=MenuToggleButton, Path=IsChecked}"
                               LeftDrawerCornerRadius="0 20 20 0"
                               OpenMode="Modal">
      <!--<materialDesign:DrawerHost.LeftDrawerContent>
        <DockPanel MinWidth="220">
          <DockPanel Margin="16" DockPanel.Dock="Top" LastChildFill="False">
            <Grid Width="36" Height="36" DockPanel.Dock="Left">
              <Ellipse Fill="{DynamicResource PrimaryHueMidBrush}" />
              <Ellipse Margin="2.5"
                       Fill="{DynamicResource PrimaryHueLightBrush}"
                       Opacity="0.35" />
              <TextBlock Text="W"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="{StaticResource AppFontBold}"
                         FontSize="16"
                         FontWeight="Bold"
                         Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
            </Grid>
            <TextBlock Margin="10,0,10,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"
                       Style="{StaticResource MaterialDesignTitleLargeTextBlock}"
                       Text="服务管理器"
                       TextWrapping="Wrap" />
          </DockPanel>

          <ListBox Margin="12,16,12,16"
                   ItemsSource="{Binding PrimaryNavigationItems}"
                   SelectionChanged="NavigationList_OnSelectionChanged"
                   SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                   Style="{StaticResource SidebarNavigationListBoxStyle}">
            <ListBox.Resources>
              <DataTemplate DataType="{x:Type models:NavigationItem}">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
              <Style TargetType="ScrollViewer" BasedOn="{StaticResource MaterialDesignScrollViewer}" />
              <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}" />
            </ListBox.Resources>
          </ListBox>
        </DockPanel>
      </materialDesign:DrawerHost.LeftDrawerContent>-->

      <DockPanel>
        <materialDesign:ColorZone DockPanel.Dock="Top"
                                  Mode="Standard"
                                  Padding="16,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
              <ToggleButton x:Name="MenuToggleButton"
                            Margin="0,0,16,0"
                            Click="MenuToggleButton_OnClick"
                            IsChecked="False"
                            Style="{StaticResource MaterialDesignHamburgerToggleButton}" />

              <Image x:Name="AppLogoImage"
                     Width="38"
                     Height="38"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     SnapsToDevicePixels="True"
                     RenderOptions.BitmapScalingMode="HighQuality" />

              <TextBlock x:Name="AppTitleTextBlock"
                         VerticalAlignment="Center"
                         Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                         Text="WSM" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Style="{StaticResource MaterialDesignTitleLargeTextBlock}"
                       Text="{Binding SelectedPageTitle}" />

            <materialDesign:PopupBox Grid.Column="2"
                                     PlacementMode="BottomAndAlignRightEdges"
                                     HorizontalAlignment="Right"
                                     StaysOpen="False">
              <StackPanel Margin="10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Text="浅色" />
                  <ToggleButton x:Name="DarkModeToggleButton"
                                Grid.Column="1"
                                Click="MenuDarkModeButton_Click" />
                  <TextBlock Grid.Column="2"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             Text="深色" />
                </Grid>
              </StackPanel>
            </materialDesign:PopupBox>
          </Grid>
        </materialDesign:ColorZone>

        <materialDesign:Snackbar x:Name="RootSnackbar"
                                 DockPanel.Dock="Bottom" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid x:Name="NavRailPanel"
                Grid.Column="0"
                Width="80"
                Background="{DynamicResource MaterialDesign.Brush.Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--<Button Grid.Row="0"
                    Width="48"
                    Height="48"
                    Margin="0,16,0,16"
                    Click="RailMenuButton_OnClick"
                    Style="{StaticResource MaterialDesignToolButton}">
              <materialDesign:PackIcon Kind="Menu" Width="24" Height="24" />
            </Button>-->

            <Viewbox Grid.Row="1"
                     VerticalAlignment="Top"
                     Stretch="Uniform">
              <ListBox VerticalAlignment="Top"
                       ItemsSource="{Binding PrimaryNavigationItems}"
                       SelectionChanged="NavigationList_OnSelectionChanged"
                       SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                       Style="{StaticResource SidebarRailNavigationListBoxStyle}">
                <ListBox.Resources>
                  <DataTemplate DataType="{x:Type models:NavigationItem}">
                    <TextBlock Text="{Binding Title}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                  </DataTemplate>
                </ListBox.Resources>
              </ListBox>
            </Viewbox>
          </Grid>
          <ContentControl Grid.Column="1"
               Margin="24"
               Content="{Binding CurrentPageViewModel}" />

        </Grid>
      </DockPanel>
    </materialDesign:DrawerHost>
  </materialDesign:DialogHost>
</Window>
