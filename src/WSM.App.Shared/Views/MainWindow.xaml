<Window x:Class="WSM.App.Shared.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:WSM.App.Shared.ViewModels"
        xmlns:views="clr-namespace:WSM.App.Shared.Views"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="720"
        Width="1200"
        MinHeight="560"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="Microsoft YaHei UI"
        Background="{DynamicResource MaterialDesignPaper}">

  <Window.Resources>
    <DataTemplate x:Key="NavigationItemTemplate">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon x:Name="NavItemIcon"
                                 Kind="{Binding IconKind}"
                                 Width="18"
                                 Height="18"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"
                                 Foreground="{DynamicResource MaterialDesignBody}" />

        <TextBlock x:Name="NavItemText"
                   Grid.Column="1"
                   Text="{Binding Title}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource MaterialDesignBody}"
                   VerticalAlignment="Center" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
          <Setter TargetName="NavItemIcon" Property="Foreground" Value="#1976D2" />
          <Setter TargetName="NavItemText" Property="Foreground" Value="#1976D2" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="SidebarNavigationListBoxStyle"
           TargetType="ListBox"
           BasedOn="{StaticResource MaterialDesignNavigationPrimaryListBox}">
      <Setter Property="ItemTemplate" Value="{StaticResource NavigationItemTemplate}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignNavigationListBoxItem}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="8,1" />
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate DataType="{x:Type vm:ServiceListViewModel}">
      <views:ServiceListView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ServiceInstallViewModel}">
      <views:ServiceInstallView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ServiceConsoleViewModel}">
      <views:ServiceConsoleView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LogViewerViewModel}">
      <views:LogViewerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>

  <materialDesign:DialogHost Identifier="RootDialogHost">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="208" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 常驻侧边栏 -->
      <DockPanel Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}">
        <StackPanel DockPanel.Dock="Top" Margin="14,14,14,10" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Grid Width="34" Height="34">
              <Ellipse Fill="#2E7DFF" />
              <Ellipse Margin="2.5"
                       Fill="#5C93FF"
                       Opacity="0.35" />
              <TextBlock Text="W"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="16"
                         FontWeight="Bold"
                         Foreground="White" />
            </Grid>
            <TextBlock Text="服务管理器"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
          <Border Height="1"
                  Margin="16,0"
                  Background="{DynamicResource MaterialDesignDivider}" />
          <ListBox ItemsSource="{Binding SecondaryNavigationItems}"
                   SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                   Style="{StaticResource SidebarNavigationListBoxStyle}" />
        </StackPanel>

        <ListBox Margin="0,10,0,0"
                 ItemsSource="{Binding PrimaryNavigationItems}"
                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                 Style="{StaticResource SidebarNavigationListBoxStyle}" />
      </DockPanel>

      <Border Grid.Column="1"
              Width="1"
              Background="{DynamicResource MaterialDesignDivider}" />

      <!-- 主内容区 -->
      <DockPanel Grid.Column="2">
        <materialDesign:ColorZone DockPanel.Dock="Top"
                                  Mode="PrimaryMid"
                                  Padding="16,12">
          <TextBlock Text="{Binding SelectedPageTitle}"
                     VerticalAlignment="Center"
                     Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
        </materialDesign:ColorZone>

        <materialDesign:Snackbar x:Name="RootSnackbar"
                                 DockPanel.Dock="Bottom" />

        <ContentControl Margin="24"
                        Content="{Binding CurrentPageViewModel}" />
      </DockPanel>
    </Grid>
  </materialDesign:DialogHost>
</Window>
