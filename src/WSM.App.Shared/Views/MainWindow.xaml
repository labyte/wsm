<Window x:Class="WSM.App.Shared.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="720"
        Width="1100"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Background="{DynamicResource MaterialDesignPaper}">

  <materialDesign:DialogHost Identifier="RootDialogHost">
    <materialDesign:DrawerHost IsLeftDrawerOpen="True">
      <materialDesign:DrawerHost.LeftDrawerContent>
        <DockPanel MinWidth="220">
          <StackPanel DockPanel.Dock="Top" Margin="16,24,16,16">
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
            <TextBlock Text="服务管理"
                       Margin="0,4,0,0"
                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Opacity="0.7" />
          </StackPanel>

          <ListBox Margin="0,8,0,0"
                   SelectedItem="{Binding SelectedPage}"
                   Style="{StaticResource MaterialDesignNavigationPrimaryListBox}">
            <ListBoxItem Content="服务总览" />
            <ListBoxItem Content="添加服务" />
            <ListBoxItem Content="日志中心" />
            <ListBoxItem Content="设置" />
          </ListBox>
        </DockPanel>
      </materialDesign:DrawerHost.LeftDrawerContent>

      <DockPanel>
        <materialDesign:ColorZone DockPanel.Dock="Top"
                                  Mode="PrimaryMid"
                                  Padding="16,12">
          <DockPanel>
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=materialDesign:DrawerHost}}">
              <materialDesign:PackIcon Kind="Menu" />
            </Button>
            <TextBlock Text="{Binding SelectedPage}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
          </DockPanel>
        </materialDesign:ColorZone>

        <Grid Margin="24">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <materialDesign:PackIcon Kind="Server"
                                     Width="72"
                                     Height="72"
                                     HorizontalAlignment="Center"
                                     Opacity="0.35" />
            <TextBlock Text="{Binding Subtitle}"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
            <TextBlock Text="P0 脚手架已就绪。关闭窗口将最小化到托盘；托盘右键可退出。"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="520"
                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                       Opacity="0.75" />
            <Button Content="测试 Snackbar 提示"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="OnTestSnackbarClick" />
          </StackPanel>
        </Grid>

        <materialDesign:Snackbar x:Name="RootSnackbar"
                                 DockPanel.Dock="Bottom" />
      </DockPanel>
    </materialDesign:DrawerHost>
  </materialDesign:DialogHost>
</Window>
