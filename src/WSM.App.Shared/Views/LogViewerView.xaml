<UserControl x:Class="WSM.App.Shared.Views.LogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:WSM.App.Shared.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="480"
             d:DesignWidth="900">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="WSM 操作日志"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />

        <ComboBox Margin="0,0,12,0"
                  MinWidth="220"
                  VerticalAlignment="Center"
                  materialDesign:HintAssist.Hint="综合或服务"
                  ItemsSource="{Binding ServiceOptions}"
                  SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName" />

        <CheckBox Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  IsChecked="{Binding IsTracking, Mode=TwoWay}"
                  Content="实时跟踪" />

        <CheckBox Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  IsChecked="{Binding IsWrapEnabled, Mode=TwoWay}"
                  Content="自动换行" />

        <TextBlock Text="最大条数"
                   Margin="0,0,6,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource MaterialDesignBody2TextBlock}" />

        <ComboBox Margin="0,0,12,0"
                  MinWidth="120"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding MaxLineOptions}"
                  SelectedItem="{Binding SelectedMaxLines, Mode=TwoWay}" />

        <ToolBarTray IsLocked="True"
                     Background="Transparent">
          <ToolBar>
            <Button Command="{Binding ExportCommand}"
                    ToolTip="导出日志">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Export" Width="20" Height="20" />
                <TextBlock Margin="6,0,0,0" Text="导出" />
              </StackPanel>
            </Button>
            <Button Command="{Binding CopyAllCommand}"
                    ToolTip="复制全部日志">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ContentCopy" Width="20" Height="20" />
                <TextBlock Margin="6,0,0,0" Text="复制" />
              </StackPanel>
            </Button>
            <Button Command="{Binding RefreshCommand}"
                    ToolTip="刷新日志">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                <TextBlock Margin="6,0,0,0" Text="刷新" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ClearCommand}"
                    ToolTip="清空日志">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" />
                <TextBlock Margin="6,0,0,0" Text="清空" />
              </StackPanel>
            </Button>
          </ToolBar>
        </ToolBarTray>
      </StackPanel>

      <TextBlock Text="{Binding StatusText}"
                 Margin="0,6,0,0"
                 Opacity="0.65"
                 Style="{StaticResource MaterialDesignBody2TextBlock}" />
    </StackPanel>

    <controls:ConsoleLogView Grid.Row="1"
                             Text="{Binding DisplayText}"
                             WrapLines="{Binding IsWrapEnabled}"
                             AutoScroll="{Binding IsTracking}" />
  </Grid>
</UserControl>
